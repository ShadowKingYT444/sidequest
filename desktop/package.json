{
  "name": "sidequest-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "start": "electron .",
    "test:electron": "node scripts/electron-smoke.mjs",
    "install:electron": "install-electron",
    "inspect:office": "node scripts/inspect-assets.mjs public/office/office.glb"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "overrides": {"dompurify":"3.4.17"},
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
